# /etc/systemd/system/firehose.service
[Unit]
Description=Firehose — score feeds with Jev
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/firehose
EnvironmentFile=/opt/firehose/.env
ExecStart=/usr/bin/python3 -m firehose run
User=firehose
Group=firehose
# the rest of the filesystem stays read-only; the app dir must be writable
# because the scorer creates out/ and state/ on first run
ProtectSystem=strict
ReadWritePaths=/opt/firehose
PrivateTmp=true
NoNewPrivileges=true
