# --- required -------------------------------------------------------------
# Jev, via AI/ML API (what you have). Backend "aimlapi" in config.toml.
AIMLAPI_API_KEY=

# Atria Dawn Preview — the reasoning/writing half. Only the chat needs this;
# the scorer runs fine without it.
ATRIA_API_KEY=

# Shared secret between the web server and the bridge. Optional on localhost.
# REQUIRED the moment this is reachable from the internet — the bridge spends
# your Jev and Atria credits, so an open one is an open wallet.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FIREHOSE_TOKEN=

# --- optional -------------------------------------------------------------
# A native TypeSafe key instead of AI/ML. Set backend = "typesafe".
# TYPESAFE_API_KEY=

# US federal tenders (SAM.gov). Free: sam.gov > Account Details > Public API Key.
# Without this, the SAM source is skipped with a warning; the rest still runs.
# A new key with no SAM.gov role is capped near 10 requests/day.
# SAM_API_KEY=

# LangSmith tracing for the agent — see exactly why it called what.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
